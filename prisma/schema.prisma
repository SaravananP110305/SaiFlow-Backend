// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum LeadStatus {
  NEW
  ASSIGNED
  CONTACTED
  MEETING_SCHEDULED
  QUALIFIED
  PROPOSAL
  NEGOTIATION
  WON
  LOST
  DISQUALIFIED
}

enum MeetingStatus {
  SCHEDULED
  COMPLETED
  RESCHEDULED
  CANCELLED
}

model Role {
  id          Int       @id @default(autoincrement())
  name        String    @unique @db.VarChar(100)
  status      String    @default("Active")
  permissions Json      @default("{}")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")
  users       User[]

  @@map("roles")
}

model User {
  id               Int          @id @default(autoincrement())
  name             String       @db.VarChar(200)
  email            String       @unique @db.VarChar(255)
  passwordHash     String       @map("password_hash") @db.VarChar(255)
  phone            String?      @db.VarChar(20)
  department       String?      @db.VarChar(100)
  roleId           Int          @map("role_id")
  status           UserStatus   @default(ACTIVE)
  refreshTokenHash String?      @map("refresh_token_hash") @db.VarChar(255)
  createdAt        DateTime     @default(now()) @map("created_at")
  updatedAt        DateTime     @updatedAt @map("updated_at")
  deletedAt        DateTime?    @map("deleted_at")
  
  role                    Role         @relation(fields: [roleId], references: [id])
  assignedLeads           Lead[]       @relation("AssignedLeads")
  createdMeetings         Meeting[]    @relation("CreatedMeetings")
  createdProposals        Proposal[]   @relation("CreatedProposals")
  managedProjects         Project[]    @relation("ProjectManager")
  clientRelationshipMgmt  Client[]     @relation("ClientRelationshipManager")
  clientAccountMgmt       Client[]     @relation("ClientAccountManager")
  auditLogs               AuditLog[]
  createdConnects         Connect[]    @relation("CreatedConnects")

  @@map("users")
}

model MasterItem {
  id              Int          @id @default(autoincrement())
  category        String       @db.VarChar(50) // 'LEAD_SOURCE', 'INDUSTRY', 'TECH_STACK', 'PRIORITY', 'COUNTRY', 'STATE', 'CITY'
  name            String       @db.VarChar(100)
  status          String       @default("Active") @db.VarChar(20)
  parentId        Int?         @map("parent_id")
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")

  parent          MasterItem?  @relation("ParentChild", fields: [parentId], references: [id])
  children        MasterItem[] @relation("ParentChild")
  
  companyIndustry Company[]    @relation("CompanyIndustry")
  companyCountry  Company[]    @relation("CompanyCountry")
  companyState    Company[]    @relation("CompanyState")
  companyCity     Company[]    @relation("CompanyCity")
  
  leadSource      Lead[]       @relation("LeadSource")
  leadPriority    Lead[]       @relation("LeadPriority")
  leadIndustry    Lead[]       @relation("LeadIndustry")
  leadCountry     Lead[]       @relation("LeadCountry")
  leadState       Lead[]       @relation("LeadState")
  leadCity        Lead[]       @relation("LeadCity")

  @@map("master_items")
}

model Company {
  id            Int         @id @default(autoincrement())
  name          String      @db.VarChar(255)
  website       String?     @db.VarChar(255)
  address       String?     @db.Text
  pincode       String?     @db.VarChar(20)
  companyType   String?     @map("company_type") @db.VarChar(100)
  industryId    Int?        @map("industry_id")
  countryId     Int?        @map("country_id")
  stateId       Int?        @map("state_id")
  cityId        Int?        @map("city_id")
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")
  deletedAt     DateTime?   @map("deleted_at")

  industry      MasterItem? @relation("CompanyIndustry", fields: [industryId], references: [id])
  country       MasterItem? @relation("CompanyCountry", fields: [countryId], references: [id])
  state         MasterItem? @relation("CompanyState", fields: [stateId], references: [id])
  city          MasterItem? @relation("CompanyCity", fields: [cityId], references: [id])
  clients       Client[]

  @@map("companies")
}

model Lead {
  id                Int        @id @default(autoincrement())
  // Lead is self-contained: all company/address details are stored directly on
  // the lead (no Company relation) so the Lead Management module needs no joins.
  title             String     @db.VarChar(255) // company/lead display name
  contactPerson     String     @map("contact_person") @db.VarChar(150)
  email             String     @db.VarChar(255)
  phone             String?    @db.VarChar(20)
  designation       String?    @db.VarChar(150)
  alternatePhone    String?    @map("alternate_phone") @db.VarChar(20)
  alternateEmail    String?    @map("alternate_email") @db.VarChar(255)
  website           String?    @db.VarChar(255)
  companyType       String?    @map("company_type") @db.VarChar(100)
  address           String?    @db.Text
  pincode           String?    @db.VarChar(20)
  industryId        Int?       @map("industry_id")
  countryId         Int?       @map("country_id")
  stateId           Int?       @map("state_id")
  cityId            Int?       @map("city_id")
  sourceId          Int?       @map("source_id")
  priorityId        Int?       @map("priority_id")
  assignedToId      Int?       @map("assigned_to_id")
  status            LeadStatus @default(NEW)
  requirements      String?    @db.Text
  assignedAt        DateTime?  @map("assigned_at")
  createdAt         DateTime   @default(now()) @map("created_at")
  updatedAt         DateTime   @updatedAt @map("updated_at")
  deletedAt         DateTime?  @map("deleted_at")

  source       MasterItem? @relation("LeadSource", fields: [sourceId], references: [id])
  priority     MasterItem? @relation("LeadPriority", fields: [priorityId], references: [id])
  industry     MasterItem? @relation("LeadIndustry", fields: [industryId], references: [id])
  country      MasterItem? @relation("LeadCountry", fields: [countryId], references: [id])
  state        MasterItem? @relation("LeadState", fields: [stateId], references: [id])
  city         MasterItem? @relation("LeadCity", fields: [cityId], references: [id])
  assignedTo   User?       @relation("AssignedLeads", fields: [assignedToId], references: [id])
  meetings     Meeting[]
  proposals    Proposal[]
  clients      Client[]
  connects     Connect[]

  @@index([assignedToId])
  @@index([status])
  @@index([title])
  @@index([email])
  @@index([sourceId])
  @@index([priorityId])
  @@index([industryId])
  @@index([countryId])
  @@index([stateId])
  @@index([cityId])
  @@index([status, assignedToId])
  @@index([assignedToId, createdAt])
  @@map("leads")
}

model Meeting {
  id              Int           @id @default(autoincrement())
  leadId          Int           @map("lead_id")
  title           String        @db.VarChar(255)
  scheduledAt     DateTime      @map("scheduled_at")
  durationMinutes Int           @default(30) @map("duration_minutes")
  meetingLink     String?       @map("meeting_link") @db.VarChar(500)
  status          MeetingStatus @default(SCHEDULED)
  agenda          String?       @db.Text
  scopeNotes      String?       @map("scope_notes") @db.Text
  createdById     Int           @map("created_by_id")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  lead            Lead          @relation(fields: [leadId], references: [id], onDelete: Cascade)
  createdBy       User          @relation("CreatedMeetings", fields: [createdById], references: [id])

  @@map("meetings")
}

model Proposal {
  id             Int       @id @default(autoincrement())
  leadId         Int       @map("lead_id")
  proposalNumber String    @unique @map("proposal_number") @db.VarChar(50)
  title          String    @db.VarChar(255)
  amount         Decimal   @db.Decimal(14, 2)
  status         String    @default("Draft") @db.VarChar(50)
  documentUrl    String?   @map("document_url") @db.VarChar(500)
  validUntil     DateTime? @map("valid_until") @db.Date
  createdById    Int       @map("created_by_id")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  lead           Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  createdBy      User      @relation("CreatedProposals", fields: [createdById], references: [id])

  @@map("proposals")
}

model Client {
  id                      Int       @id @default(autoincrement())
  companyId               Int       @map("company_id")
  leadId                  Int?      @map("lead_id")
  gstPan                  String?   @map("gst_pan") @db.VarChar(100)
  paymentTerms            String?   @map("payment_terms") @db.VarChar(50)
  creditLimit             Decimal?  @map("credit_limit") @db.Decimal(14, 2)
  relationshipManagerId   Int?      @map("relationship_manager_id")
  accountManagerId        Int?      @map("account_manager_id")
  status                  String    @default("Active") @db.VarChar(20)
  createdAt               DateTime  @default(now()) @map("created_at")
  updatedAt               DateTime  @updatedAt @map("updated_at")
  deletedAt               DateTime? @map("deleted_at")

  company             Company @relation(fields: [companyId], references: [id])
  lead                Lead?   @relation(fields: [leadId], references: [id])
  relationshipManager User?   @relation("ClientRelationshipManager", fields: [relationshipManagerId], references: [id])
  accountManager      User?   @relation("ClientAccountManager", fields: [accountManagerId], references: [id])
  projects            Project[]

  @@map("clients")
}

model Project {
  id             Int       @id @default(autoincrement())
  clientId       Int       @map("client_id")
  name           String    @db.VarChar(255)
  pmId           Int?      @map("pm_id")
  status         String    @default("Kickoff") @db.VarChar(50)
  handoverDate   DateTime? @map("handover_date")
  srsDocumentUrl String?   @map("srs_document_url") @db.VarChar(500)
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  client         Client    @relation(fields: [clientId], references: [id])
  pm             User?     @relation("ProjectManager", fields: [pmId], references: [id])

  @@map("projects")
}

model Connect {
  id            Int       @id @default(autoincrement())
  leadId        Int       @map("lead_id")
  // Denormalized lead display fields so the Contact / Follow-up pages need no joins.
  company       String    @db.VarChar(255)
  contactPerson String?   @map("contact_person") @db.VarChar(150)
  phone         String?   @db.VarChar(20)
  assignedTo    String?   @map("assigned_to") @db.VarChar(150)
  // Contact outcome: CONTACTED / INTERESTED / CALL_LATER / NOT_INTERESTED
  outcome       String?   @db.VarChar(30)
  summary       String?   @db.Text
  followUpType  String?   @map("follow_up_type") @db.VarChar(30)
  followUpDate  String?   @map("follow_up_date") @db.VarChar(10)
  followUpTime  String?   @map("follow_up_time") @db.VarChar(10)
  // Follow-up lifecycle: SCHEDULED / COMPLETED / MISSED / RESCHEDULED
  status        String    @default("SCHEDULED") @db.VarChar(30)
  createdById   Int?      @map("created_by_id")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  deletedAt     DateTime? @map("deleted_at")

  lead          Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  createdBy     User?     @relation("CreatedConnects", fields: [createdById], references: [id])

  @@index([leadId])
  @@index([status])
  @@index([createdById])
  @@map("connect")
}

model AuditLog {
  id        BigInt   @id @default(autoincrement())
  userId    Int?     @map("user_id")
  action    String   @db.VarChar(100)
  entity    String   @db.VarChar(50)
  entityId  Int      @map("entity_id")
  payload   Json?
  ipAddress String?  @map("ip_address") @db.VarChar(45)
  createdAt DateTime @default(now()) @map("created_at")

  user      User?    @relation(fields: [userId], references: [id])

  @@map("audit_logs")
}
